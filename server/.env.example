# Copy to .env (server auto-loads it via --env-file, or use `node --env-file=.env src/index.js`).
# All optional.

# Port to listen on (default 3001).
PORT=3002

# Shared secret required on writes (POST/PATCH/DELETE) as the `x-api-key` header.
# Leave unset when everything is on localhost; set it once the API is public.
API_KEY=

# --- Discord "up now" reminders --------------------------------------------
# Simple mode: an incoming webhook. Posts "@here 🔔 up now — Zone", no buttons.
# Discord: channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy URL.
DISCORD_WEBHOOK_URL=

# Button mode (recommended): set the bot token + channel + public key instead of
# (or as well as) the webhook. Each zone in the reminder then gets a "Got <zone>"
# button (logs the collect, restarts the timer) and a "Skip" button (blanks the
# timer — nobody's going for it).
#   DISCORD_BOT_TOKEN   -> same token as bot/.env (Dev Portal -> Bot -> Reset Token)
#   DISCORD_CHANNEL_ID  -> the reminder channel id
#   DISCORD_PUBLIC_KEY  -> Dev Portal -> General Information -> Public Key
# Then in Dev Portal -> General Information set "Interactions Endpoint URL" to
#   https://<your-domain>/api/discord/interactions
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_PUBLIC_KEY=

# Set the application id too and the server registers a "/up <zone> <time>" slash
# command on boot (log a reset straight from Discord). Dev Portal -> General Information -> Application ID.
DISCORD_APP_ID=
# Timezone the clan calls times in — used to read "/up ... time:3:50pm". Default Asia/Manila.
DISCORD_CLAN_TZ=Asia/Manila
# Your server (guild) id — right-click the server icon -> Copy Server ID. With this
# set, /up appears in that server instantly; without it, global registration takes ~1h.
DISCORD_GUILD_ID=

# Which zone types get a reminder. Default: red_card,elite (blue rooms are loot).
DISCORD_ANNOUNCE_TYPES=red_card,elite

# Post a quiet "⏳ up in ~N min" heads-up this many minutes before a zone is due. 0 = off.
DISCORD_LEAD_MINUTES=5

# Auto-blank a zone's timer once it's this many intervals overdue (stale rows are noise).
# e.g. 4 = a 1h zone clears itself 4h after it was due. 0 = never auto-expire.
STALE_EXPIRE_FACTOR=4

# Also post a line for every reset / claim logged on the website (chatty). Default off.
DISCORD_MIRROR_ACTIONS=0
