# --- required ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications  (Bot -> Reset Token)
DISCORD_TOKEN=

# Channel(s) to watch. Right-click the channel in Discord -> Copy Channel ID
# (enable Developer Mode in Discord settings first). Comma-separate for several.
WATCH_CHANNEL_ID=

# --- api -------------------------------------------------------------------
# Where the timer backend lives. Use the PORT your server actually runs on
# (this project has been running on 3002; the spec default is 3001).
API_URL=http://localhost:3002/api
# Only needed if you set API_KEY on the server (see server/.env).
API_SECRET=

# --- optional ------------------------------------------------------------
# 1 = parse and log to console but do NOT write to the API (for testing).
DRY_RUN=0
# On startup, replay messages from the last N minutes (0 = off).
BACKFILL_MINUTES=0
# Timezone the clan types times in (they're 12-hour). Default Asia/Manila.
CLAN_TZ=Asia/Manila
# Fuzzy-match strictness, 0-1. Lower = catches more typos but risks wrong zones.
MATCH_THRESHOLD=0.72
